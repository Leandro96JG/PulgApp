<Window x:Class="Pulgapp.Server.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pulgapp Server" Height="620" Width="760" MinHeight="580" MinWidth="680"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Pulgapp" />
            <TextBlock Foreground="DimGray" Text="LAN gamepad server" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="Server" Padding="12">
                <StackPanel>
                    <TextBlock Text="Status" FontWeight="SemiBold" />
                    <TextBlock x:Name="ServerStatusText" Margin="0,2,0,10" />
                    <TextBlock Text="Driver" FontWeight="SemiBold" />
                    <TextBlock x:Name="DriverStatusText" Margin="0,2,0,10" />
                    <TextBlock Text="TCP / UDP ports" FontWeight="SemiBold" />
                    <TextBlock x:Name="PortsText" Margin="0,2,0,10" />
                    <TextBlock Text="PIN" FontWeight="SemiBold" />
                    <TextBlock x:Name="PinText" FontSize="24" FontFamily="Consolas" Margin="0,2,0,0" />
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="LAN addresses" Padding="12">
                <StackPanel>
                    <TextBlock Text="Connect a phone to any of these IPv4 addresses:" TextWrapping="Wrap" />
                    <TextBlock x:Name="AddressesText" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="4" Header="Pulgapp slots" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SlotsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Pulgapp slot" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SlotLabel}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Controller" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ControllerType}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Client / IP" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ClientAndAddress}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Connection" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ConnectionState}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Input / XInput index" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding InputAndXInput}" />
                                        <TextBlock Text="{Binding Metrics}" Foreground="DimGray" />
                                    </StackPanel>
                                    <Button Grid.Column="5" Width="80" VerticalAlignment="Center" Tag="{Binding SlotNumber}" Click="KickSlotButton_Click" IsEnabled="{Binding CanKick}">Kick</Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StartButton" Width="104" Margin="0,0,8,0" Click="StartButton_Click">Start Server</Button>
            <Button x:Name="StopButton" Width="104" Margin="0,0,8,0" Click="StopButton_Click">Stop Server</Button>
            <Button x:Name="RegeneratePinButton" Width="112" Margin="0,0,8,0" Click="RegeneratePinButton_Click">Regenerate PIN</Button>
        </StackPanel>
    </Grid>
</Window>
